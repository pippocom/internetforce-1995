!
version 10.2
!
hostname gw-enter.inet.it
!
enable secret 5 $1$SCM7$UnBVOyS8/9sJP9fqF131j0
enable password 5 <ORIGINAL PASSWORD REMOVED>
!
username guest nopassword
username guest autocommand connect users
ip subnet-zero
!
interface Ethernet0
ip address 194.20.50.19 255.255.255.224
!
interface Serial0
no ip address
encapsulation lapb multi
shutdown
!
interface Serial1
no ip address                                                                  
!
interface Async1
ip unnumbered Ethernet0
ip tcp header-compression passive
encapsulation ppp
async default ip address 194.20.50.65
async mode interactive
!
