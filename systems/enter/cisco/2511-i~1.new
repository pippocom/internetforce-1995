ip domain-name inet.it.                                                        
ip name-server 194.20.8.4
ip route 0.0.0.0 0.0.0.0 194.20.50.1
ip route 194.20.50.0 255.255.255.224 Ethernet0
ip route 194.20.50.32 255.255.255.224 Ethernet0
tacacs-server host 194.20.50.2
tacacs-server last-resort succeed
snmp-server community <ORIGINAL SECRET REMOVED> RO
!
line con 0
exec-timeout 0 0
terminal-type vt100
exec-character-bits 8
line 1
exec-timeout 0 0
login tacacs
modem ri-is-cd
terminal-type vt100
exec-character-bits 8
stopbits 1
rxspeed 115200
txspeed 115200
flowcontrol hardware                                                           
exec-timeout 0 30
login tacacs
modem ri-is-cd
terminal-type vt100
exec-character-bits 8
no history
stopbits 1
rxspeed 115200
txspeed 115200
flowcontrol hardware
