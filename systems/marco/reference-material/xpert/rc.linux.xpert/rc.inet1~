#! /bin/sh
#
# rc.inet1	This shell script boots up the base INET system.
#
# Version:	@(#)/etc/rc.d/rc.inet1	1.01	05/27/93
#

HOSTNAME=`cat /etc/HOSTNAME`

# Attach the loopback device.
/sbin/ifconfig lo 127.0.0.1
/sbin/route add -net 127.0.0.0

# IF YOU HAVE AN ETHERNET CONNECTION, use these lines below to configure the 
# eth0 interface. If you're only using loopback or SLIP, don't include the
# rest of the lines in this file.

# Edit for your setup.
IPADDR="199.203.132.1"	# REPLACE with YOUR IP address!
IPADDR2="199.203.132.2" # www.elmar.co.il
IPADDR3="199.203.132.7" # yahel.org
NETMASK="255.255.255.0"	# REPLACE with YOUR netmask!
NETWORK="199.203.132.0"	# REPLACE with YOUR network address!
BROADCAST="199.203.132.255"	# REPLACE with YOUR broadcast address, if you
			# have one. If not, leave blank and edit below.
GATEWAY="199.203.132.254" # REPLACE with YOUR gateway address!

# Uncomment ONLY ONE of the three lines below. If one doesn't work, try again.
# /sbin/ifconfig eth0 ${IPADDR} netmask ${NETMASK} broadcast ${BROADCAST}
/sbin/ifconfig eth0 ${IPADDR} broadcast ${BROADCAST} netmask ${NETMASK}
# /sbin/ifconfig  eth0 ${IPADDR} netmask ${NETMASK} 

# Uncomment these to set up your IP routing table.
/sbin/route add -net ${NETWORK} netmask ${NETMASK}
#/sbin/route add default gw ${GATEWAY} metric 1  (limor commented)

# Set up virtual address - for www.elmar.co.il
# this should be dummy1 (after module will be loaded)
/sbin/ifconfig dummy ${IPADDR2} netmask ${NETMASK} broadcast ${BROADCAST} up
/sbin/route add ${IPADDR2} dummy
/sbin/arp -s ${IPADDR2} 00:00:21:34:40:79 pub

# Set up virtual address - for yahel.org
/sbin/ifconfig dummy2 ${IPADDR3} netmask ${NETMASK} broadcast ${BROADCAST} up
/sbin/route add ${IPADDR3} dummy2
/sbin/arp -s ${IPADDR3} 00:00:21:34:40:79 pub



# End of rc.inet1
