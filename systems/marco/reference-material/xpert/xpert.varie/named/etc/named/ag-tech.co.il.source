@       IN      SOA     ag-tech.co.il. limor.xpert.com. (
                                1996070203      ; Serial
                                10800           ; Refresh 3 hours
                                3600            ; Retry 1 hour
                                604800          ; Expire after a week
                                86400 )         ; Minimum ttl 1 day

                   NS      dns.xpert.com.
                   NS      dns.ag-tech.co.il.
@		   MX 0    xpert.com.
>E 		A	199.203.132.12


