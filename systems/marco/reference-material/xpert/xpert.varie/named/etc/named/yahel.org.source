@       IN      SOA     Yahel.ORG. yahel.xpert.com. (
                                1996070202      ; Serial
                                10800           ; Refresh 3 hours
                                3600            ; Retry 1 hour
                                604800          ; Expire after a week
                                86400 )         ; Minimum ttl 1 day

                   NS      mailhost.xpert.com.
                   NS      dns.telhai.ac.il.
@		   MX 0    mailhost.xpert.com.
>E		   A	   199.203.132.7
		   HINFO	"P.O.Box 1240, Tivon 36000, ISRAEL"
		   TXT		"Yahels under the sun"
;"*"		   MX 9	   mailhost.xpert.com.

