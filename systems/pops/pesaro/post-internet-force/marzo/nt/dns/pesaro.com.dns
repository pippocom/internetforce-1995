;
;  Database file pesaro.com.dns for pesaro.com zone.
;      Zone version:  3l
;

@                       IN	SOA	data.pesaro.com.	dnsmaster.pesaro.com.	(
                        3           ; serial number
                        3600        ; refresh
                        600         ; retry
                        86400       ; expire
                        3600      ) ; minimum TTL

;
;  Zone NS records
;

@                       IN	NS	data
@                       IN	NS	dns
@                       IN	NS	dns.interbusiness.it.

;
;  Zone records
;

@                       IN	MX	10	users
@                       IN	MX	20	mail.cs.interbusiness.it.
